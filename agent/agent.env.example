# ~/agents/portal.bronxconservatory.org/agent.env (chmod 600): this agent's
# secrets and knobs. One account can run an agent per site; each lives in its
# own ~/agents/<site>/ with its own agent.env, clone, worktrees and unit.
# Loaded by the systemd unit and, for debugging, with:
#   set -a; source ~/agents/portal.bronxconservatory.org/agent.env; set +a
AGENT_DIR=/home/bronxconservatory/agents/portal.bronxconservatory.org

# Either an Anthropic Console API key (metered separately on the Console org)...
ANTHROPIC_API_KEY=sk-ant-...
# ...or a subscription token: `claude setup-token` on a machine where you are
# logged in prints a sk-ant-oat01-... value once; the agent then runs on your
# Claude plan and shares its limits with you. If both are set the API key wins.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Discord: the "SWE - bronxconservatory" bot's token, and the numeric ID of
# #bronxconservatory-features (right-click the channel > Copy Channel ID).
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Discord role names. builder: may request, discuss, "go", review, discard.
# shipper: may also "approve" (= deploy to production).
ROLE_BUILDER=builder
ROLE_SHIPPER=shipper

# Model Claude Code runs with. Fable needs Claude Code 2.1.251 or newer.
CODE_MODEL=claude-fable-5-1
# Tried in order when CODE_MODEL is overloaded or not available to this
# account (a subscription without Fable, a capacity blip). Leave empty to fail
# the turn instead of quietly using a different model.
FALLBACK_MODEL=opus,sonnet

# Spending cap for ONE agent turn, in US dollars.
MAX_BUDGET_USD=15

# Seconds one agent turn may run before the bridge gives up on it.
CLAUDE_TIMEOUT_SECONDS=3600

# Each request is served at https://<PREVIEW_PREFIX>-<slug>.<PREVIEW_DOMAIN>/
# from ~/previews/<PREVIEW_PREFIX>-<slug>/www. The prefix is the one the
# account was provisioned with (preview-account-add; docs/preview-hosts.md).
PREVIEW_DOMAIN=preview1.rosenthaltechnologies.com
PREVIEW_PREFIX=bronxconservatory

# tree: ~/previews/<label> is a symlink to the worktree, whose www/ is the web
# root (this repository). build: a real directory that agent/preview-setup.sh fills.
PREVIEW_MODE=tree


# Requests (threads with a worktree and a preview) allowed in flight at once.
MAX_WORKTREES=3
