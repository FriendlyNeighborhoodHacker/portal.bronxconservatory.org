#!/bin/bash
# preview-account-add ACCOUNT [PREFIX] [PUBLIC_DIR]
#
# One-time, as root, per Linux account that should be able to publish previews
# at https://PREFIX-<slug>.preview1.rosenthaltechnologies.com (and the bare
# https://PREFIX.preview1... for the account's own default site). After this
# the account creates a preview with nothing but a directory:
#     ~/previews/PREFIX-<slug>/PUBLIC_DIR/      (PUBLIC_DIR defaults to www)
# No DNS, certificate, Apache or root step per preview: the wildcard record and
# wildcard certificate were issued once for the whole machine
# (docs/preview-hosts.md), and the per-account vhost created here serves any
# hostname with the account's prefix out of that account's previews directory.
#
# Creates (idempotently): a php-fpm pool running as the account, the vhost
# preview-ACCOUNT.conf with the account's prefix, and ~/previews. Safe to re-run.
#
# Install once:  install -m 755 agent/server/preview-account-add /usr/local/sbin/
set -euo pipefail

DOMAIN=preview1.rosenthaltechnologies.com
CERT_NAME=preview1.rosenthaltechnologies.com          # certbot lineage holding the wildcard
PHPV=8.4

ACCOUNT=${1:?usage: preview-account-add ACCOUNT [PREFIX] [PUBLIC_DIR]}
PREFIX=${2:-$ACCOUNT}
PUBLIC=${3:-www}

[ "$(id -u)" -eq 0 ] || { echo "run as root (sudo)"; exit 1; }
id "$ACCOUNT" >/dev/null                                 # account must exist
[[ "$PREFIX" =~ ^[a-z0-9]+$ ]] || { echo "PREFIX must be lowercase letters and digits only (it is a hostname label and ends with '-')"; exit 1; }
[ -d /etc/letsencrypt/live/$CERT_NAME ] || { echo "wildcard certificate $CERT_NAME not issued yet (docs/preview-hosts.md step 3)"; exit 1; }
HOME_DIR=$(getent passwd "$ACCOUNT" | cut -d: -f6)

# Apache (www-data) serves static files straight from the account's tree.
chmod o+x "$HOME_DIR"
install -d -o "$ACCOUNT" -g "$ACCOUNT" -m 755 "$HOME_DIR/previews"

# php-fpm pool running as the account, so PHP can read owner-only config files.
POOL=/etc/php/$PHPV/fpm/pool.d/$ACCOUNT.conf
if [ ! -f "$POOL" ]; then
    sed -e "s/^\[www\]/[$ACCOUNT]/" \
        -e "s/^user = .*/user = $ACCOUNT/" \
        -e "s/^group = .*/group = $ACCOUNT/" \
        -e "s|^listen = .*|listen = /run/php/php$PHPV-fpm-$ACCOUNT.sock|" \
        /etc/php/$PHPV/fpm/pool.d/www.conf > "$POOL"
    php-fpm$PHPV -t
    systemctl reload php$PHPV-fpm
fi

a2enmod -q vhost_alias ssl rewrite proxy_fcgi >/dev/null

VHOST=/etc/apache2/sites-available/preview-$ACCOUNT.conf
cat > "$VHOST" <<CONF
# Generated by preview-account-add for account $ACCOUNT (prefix $PREFIX-).
# Serves https://$PREFIX-<slug>.$DOMAIN from $HOME_DIR/previews/$PREFIX-<slug>/$PUBLIC
# and https://$PREFIX.$DOMAIN from $HOME_DIR/previews/$PREFIX/$PUBLIC.
# Port 80 is redirected by preview-zz-fallback.conf.
<VirtualHost *:443>
    ServerName $PREFIX.$DOMAIN
    ServerAlias $PREFIX-*.$DOMAIN
    UseCanonicalName Off
    VirtualDocumentRoot $HOME_DIR/previews/%1/$PUBLIC

    <Directory $HOME_DIR/previews>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    <FilesMatch \.php\$>
        SetHandler "proxy:unix:/run/php/php$PHPV-fpm-$ACCOUNT.sock|fcgi://localhost"
    </FilesMatch>

    SSLEngine on
    SSLCertificateFile    /etc/letsencrypt/live/$CERT_NAME/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/$CERT_NAME/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    ErrorLog  \${APACHE_LOG_DIR}/preview-$ACCOUNT-error.log
    CustomLog \${APACHE_LOG_DIR}/preview-$ACCOUNT-access.log vhost_combined
</VirtualHost>
CONF

a2ensite -q "preview-$ACCOUNT" >/dev/null
apache2ctl configtest
systemctl reload apache2

echo "ok: $ACCOUNT publishes https://$PREFIX-<slug>.$DOMAIN from $HOME_DIR/previews/$PREFIX-<slug>/$PUBLIC"
echo "    (log in as $ACCOUNT and: mkdir -p ~/previews/$PREFIX-hello/$PUBLIC; echo hello > ~/previews/$PREFIX-hello/$PUBLIC/index.html)"
