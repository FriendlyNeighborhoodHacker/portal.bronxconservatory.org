# /etc/sudoers.d/bcmagent  (install with: sudo install -m 440 agent/sudoers.d/bcmagent /etc/sudoers.d/bcmagent)
#
# The engineer agent's account has full passwordless sudo (Brian's decision,
# Nov 2026) so it can be asked to do server chores. What the MODEL may run is
# the much shorter sudo list in agent/settings.json; widen that, not this.
# The bridge itself never uses sudo.
bcmagent ALL=(ALL) NOPASSWD: ALL
