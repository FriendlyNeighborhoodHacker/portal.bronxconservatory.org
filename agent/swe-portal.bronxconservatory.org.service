# /etc/systemd/system/swe-bronxconservatory.service
# Runs the machine-wide swe-bridge (docs/swe-bridge.md) for this repository's
# agent, as the bronxconservatory account.
#   sudo systemctl daemon-reload && sudo systemctl enable --now swe-bronxconservatory
#   journalctl -fu swe-bronxconservatory
[Unit]
Description=swe-bridge for the Bronx Conservatory engineer agent (SWE - bronxconservatory)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
User=bronxconservatory
WorkingDirectory=/home/bronxconservatory/agent
EnvironmentFile=/home/bronxconservatory/.agent.env
Environment=PATH=/home/bronxconservatory/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/lib/swe-bridge/venv/bin/python /usr/local/lib/swe-bridge/bridge.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
