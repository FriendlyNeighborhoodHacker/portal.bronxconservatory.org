<?php
// Local configuration for the BCM Family Portal (do not commit the real config.local.php)
//
// Copy this file to config.local.php and fill in your environment-specific values.

define('DB_HOST', '');
define('DB_NAME', 'bronx_music_conservatory');
define('DB_USER', '');
define('DB_PASS', '');

// Application branding (used as a fallback; UI will prefer Settings::get('site_title', APP_NAME))
define('APP_NAME', 'BCM Family Portal');

// SMTP configuration (e.g., Gmail with App Password)
define('SMTP_HOST', 'smtp.gmail.com'); // smtp.gmail.com
define('SMTP_PORT', 587);              // 587 for STARTTLS, 465 for SSL
define('SMTP_USER', '');               // your Gmail address
define('SMTP_PASS', '');               // app password (recommended)
define('SMTP_SECURE', 'tls');          // 'tls' or 'ssl'
define('SMTP_FROM_EMAIL', '');         // often the same as SMTP_USER
define('SMTP_FROM_NAME', 'Bronx Conservatory of Music'); // From name seen in emails

// HMAC key for remember me tokens (REQUIRED for persistent login).
// Set to a long random string, e.g., bin2hex(random_bytes(32)).
define('REMEMBER_TOKEN_KEY', '');

// Stripe (https://dashboard.stripe.com/apikeys; use test-mode keys in dev).
// Empty values disable online checkout.
define('STRIPE_SECRET_KEY', '');
define('STRIPE_PUBLISHABLE_KEY', '');
define('STRIPE_WEBHOOK_SECRET', '');

// Google reCAPTCHA v2 checkbox (https://www.google.com/recaptcha/admin) —
// protects the public registration form against bots. Empty values hide the
// widget and skip verification (fine for local development).
define('RECAPTCHA_SITE_KEY', '');
define('RECAPTCHA_SECRET_KEY', '');

// ===== GitHub deploy webhook (gitwebhook.php) =====
// Shared secret for the GitHub deploy webhook. Must match the secret
// configured on the GitHub webhook settings page for the repository.
// Generate with: php -r "echo bin2hex(random_bytes(32));"
// Leave empty to disable the webhook (it returns 500 "Webhook not configured").
define('GIT_WEBHOOK_SECRET', '');

// Per-machine deploy paths used by gitwebhook.php (optional — the defaults
// below are what the file uses when these are not defined).
// define('DEPLOY_SCRIPT', '/home/lillydebate/deploy_scripts/portal.bronxconservatory.org.sh');
// define('DEPLOY_LOG',    '/home/lillydebate/deploy_scripts/logs/portal.bronxconservatory.org.webhook.log');

// ===== PHP session storage =====
// Absolute path to a directory THIS account owns, holding the PHP session
// files. Leave undefined to use the server's default save_path. Set it when the
// default is shared with other accounts or belongs to a different system user:
// a save_path PHP cannot read back leaves $_SESSION empty on every request,
// which looks like "CSRF token mismatch" on every POST and a logout that never
// takes effect. The directory is created (0700) if missing.
// define('SESSION_SAVE_PATH', '/home/lillydebate/var/sessions');

// ===== Database migrations (Admin > Maintenance > Database Migrations) =====
// Absolute path to this deployment's db_migrations directory. It lives OUTSIDE
// the web root (top level of the repository), so the path is per-machine.
// Admin > Migrations is DISABLED unless this is defined and non-empty — there
// is no fallback, so no machine can apply migrations from an unexpected place.
// Production example:
// define('MIGRATIONS_DIR', '/home/lillydebate/deploy_scripts/portal.bronxconservatory.org.deploy/db_migrations');
// Local checkout (config.local.php lives in www/, so the repo root is one up):
define('MIGRATIONS_DIR', dirname(__DIR__) . '/db_migrations');

// ===== Server logs (Admin > Maintenance > Server Logs) =====
// Per-machine overrides for the server log files developers can tail in the
// browser (slug => absolute path). Only listed slugs are overridden; the rest
// keep the defaults built into www/lib/LogViewer.php (under /home/lillydebate).
// Known slugs: deploy-webhook, apache-access, apache-error, php-error.
// Example:
// define('ADMIN_LOG_FILES', [
//     'deploy-webhook' => '/home/lillydebate/deploy_scripts/logs/portal.bronxconservatory.org.webhook.log',
//     'apache-access'  => '/home/lillydebate/logs/portal.bronxconservatory.org/http/access.log',
//     'apache-error'   => '/home/lillydebate/logs/portal.bronxconservatory.org/http/error.log',
// ]);
